# ============================================
# Genggam API - Environment Variables
# Salin file ini menjadi .env lalu isi nilainya
# ============================================

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/genggam
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT ---
# Gunakan secret minimal 32 karakter (acak)
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
# Masa berlaku token dalam milidetik (12 jam = 43200000)
JWT_EXPIRATION_MS=43200000

# --- File Upload ---
# Lokasi penyimpanan foto profil (untuk dev lokal)
UPLOAD_DIR=./uploads

# --- Server ---
SERVER_PORT=8080
